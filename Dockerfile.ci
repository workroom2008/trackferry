# syntax=docker/dockerfile:1.7
# The same image as Dockerfile, built for CI. Two differences, both for speed:
#   - BuildKit cache mounts keep the npm store and the Go caches between runs;
#   - only amd64 is built (the CI workflow pins the platform).
# The version strings still go in through -ldflags: Go's build cache keeps object files per
# package, so a new commit only redoes the final link, not the compile.
FROM node:22.22.0-alpine AS web
ARG NPM_REGISTRY=https://registry.npmjs.org
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --registry=${NPM_REGISTRY} --no-audit --no-fund
COPY web ./
# vite writes to ../internal/webui/dist
RUN mkdir -p /src/internal/webui && npm run build

FROM golang:1.27.3-alpine AS build
ARG GOPROXY=https://proxy.golang.org,direct
ENV CGO_ENABLED=0 GOFLAGS=-trimpath GOPROXY=${GOPROXY}
WORKDIR /src
COPY go.mod go.sum VERSION ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod download && go mod verify
COPY cmd ./cmd
COPY internal ./internal
COPY --from=web /src/internal/webui/dist ./internal/webui/dist
ARG VERSION=
ARG COMMIT=unknown
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -ldflags "-s -w -X main.version=${VERSION:-$(cat VERSION)} -X main.commit=${COMMIT}" \
      -o /out/trackferry ./cmd/trackferry && mkdir -p /out/run
RUN /out/trackferry version

FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/trackferry /trackferry
# The shared volume takes this directory's owner.
COPY --from=build --chown=10001:10001 /out/run /run/trackferry
# Starts as root only to hand /data over, then becomes PUID:PGID (10001 unless set).
ENV TRACKFERRY_CONFIG=/data/config.yaml TZ=Asia/Shanghai
EXPOSE 18561
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["/trackferry", "healthcheck"]
ENTRYPOINT ["/trackferry"]
CMD ["serve"]
